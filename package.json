{
  "name": "kysola",
  "version": "0.1.0",
  "description": "YAML schema inference, migrations, and a typed model API for Kysely.",
  "keywords": [
    "database",
    "kysely",
    "migration",
    "schema",
    "typescript",
    "yaml"
  ],
  "license": "MIT",
  "author": "Ryuz <ryuzer@proton.me>",
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "fmt": "oxfmt",
    "typecheck": "tsc --noEmit",
    "check": "bun run test && bun run typecheck && bun run build",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "confbox": "^0.2.4",
    "dedent": "^1.7.2"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "kysely": "^0.29.5",
    "oxfmt": "^0.63.0",
    "tsdown": "^0.22.14",
    "typescript": "^7"
  },
  "peerDependencies": {
    "kysely": "^0.29.5"
  },
  "packageManager": "bun@1.3.14"
}
